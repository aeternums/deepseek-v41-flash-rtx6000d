# Copy to .env and adjust. Every value here matches the measured setup in README.md.
IMAGE=ghcr.io/local-inference-lab/vllm@sha256:faf0b1f08d688b1aaa7d5161dc3b724c701d17d68278e7d32ebdd3a6b5127ce2
NAME=ds41-flash

# Keep it on loopback and put a reverse proxy in front; 0.0.0.0 exposes an
# unauthenticated OpenAI-compatible endpoint to the network.
BIND_ADDR=127.0.0.1
PORT=8000

# Engram tables pin host memory; too low a limit fails at startup.
MEMLOCK_BYTES=274877906944

MODEL_DIR=/models/DeepSeek-V4.1-Flash-1017-lossless-CSF
CACHE_DIR=/data/ds41/cache
SERVED_NAME=DeepSeek-V4.1-Flash
