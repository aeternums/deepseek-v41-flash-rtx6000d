# Path to the pre-downloaded checkpoint (must contain config.json + safetensors).
MODEL_DIR=/models/DeepSeek-V4.1-Flash-1017-lossless-CSF

# Persistent JIT / CUDA-graph cache. Keep it across container restarts.
CACHE_DIR=/data/ds41/cache

# 127.0.0.1 keeps the port off the network; put a gateway in front of it.
BIND_ADDR=127.0.0.1
PORT=8000

# GPUs to use. TP must match the count.
SERVED_NAME=DeepSeek-V4.1-Flash
